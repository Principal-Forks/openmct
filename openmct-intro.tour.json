{
  "id": "openmct-introduction",
  "title": "Open MCT: Mission Control Framework",
  "description": "Discover how NASA's Open MCT builds extensible mission control interfaces through domain objects, telemetry, and a plugin architecture.",
  "version": "1.1.0",
  "audience": "New Contributors",
  "prerequisites": [
    "Familiarity with JavaScript and Vue basics"
  ],
  "steps": [
    {
      "id": "welcome",
      "title": "Open MCT at a Glance",
      "description": "Open MCT is NASA's extensible web framework for building mission control UIs. MCT.js is the heart — it wires together 15+ APIs (telemetry, time, objects) and a Vue-based UI into a single configurable application.",
      "focusDirectory": "src",
      "colorMode": "fileTypes",
      "highlightLayers": [
        {
          "id": "entry-point",
          "name": "Application Core",
          "color": "#ef4444",
          "items": [
            { "path": "src/MCT.js", "type": "file" },
            { "path": "openmct.js", "type": "file" }
          ],
          "opacity": 0.8,
          "renderStrategy": "border"
        }
      ]
    },
    {
      "id": "api-layer",
      "title": "The API Layer: Domain-Driven Design",
      "description": "Each API owns a core mission control concept. TelemetryAPI streams real-time data via provider subscriptions. ObjectAPI persists domain objects by namespace. TimeAPI drives the time conductor — clocks, bounds, and modes used by every view.",
      "focusDirectory": "src/api",
      "colorMode": "fileTypes",
      "highlightLayers": [
        {
          "id": "core-apis",
          "name": "Core APIs",
          "color": "#3b82f6",
          "items": [
            { "path": "src/api/telemetry", "type": "directory" },
            { "path": "src/api/objects", "type": "directory" },
            { "path": "src/api/time", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        },
        {
          "id": "interaction-apis",
          "name": "Interaction APIs",
          "color": "#f59e0b",
          "items": [
            { "path": "src/api/actions", "type": "directory" },
            { "path": "src/api/composition", "type": "directory" },
            { "path": "src/api/annotation", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        }
      ],
      "interactiveActions": [
        {
          "type": "click-file",
          "description": "See how telemetry providers and formatters are registered",
          "target": "src/api/telemetry/TelemetryAPI.js"
        }
      ]
    },
    {
      "id": "plugin-system",
      "title": "Plugin Architecture: 50+ Built-in Plugins",
      "description": "Everything is a plugin — plots, tables, notebooks, gauges, imagery. plugins.js registers them all. Each folder is self-contained with its own views, actions, and object types, making Open MCT endlessly extensible.",
      "focusDirectory": "src/plugins",
      "colorMode": "fileTypes",
      "highlightLayers": [
        {
          "id": "visualization-plugins",
          "name": "Visualization",
          "color": "#8b5cf6",
          "items": [
            { "path": "src/plugins/plot", "type": "directory" },
            { "path": "src/plugins/charts", "type": "directory" },
            { "path": "src/plugins/gauge", "type": "directory" },
            { "path": "src/plugins/imagery", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        },
        {
          "id": "layout-plugins",
          "name": "Layout & Composition",
          "color": "#10b981",
          "items": [
            { "path": "src/plugins/displayLayout", "type": "directory" },
            { "path": "src/plugins/flexibleLayout", "type": "directory" },
            { "path": "src/plugins/tabs", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        },
        {
          "id": "knowledge-plugins",
          "name": "Knowledge Capture",
          "color": "#f97316",
          "items": [
            { "path": "src/plugins/notebook", "type": "directory" },
            { "path": "src/plugins/condition", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        }
      ],
      "interactiveActions": [
        {
          "type": "click-file",
          "description": "See how all built-in plugins are registered",
          "target": "src/plugins/plugins.js"
        }
      ]
    },
    {
      "id": "ui-layer",
      "title": "Vue-Powered UI Shell",
      "description": "The UI shell handles layout, routing, inspector, and toolbar. Browse.js in src/ui/router maps URL paths to domain object views. Components use Vue composables for shared concerns like search, resize, and selection state.",
      "focusDirectory": "src/ui",
      "colorMode": "fileTypes",
      "highlightLayers": [
        {
          "id": "ui-shell",
          "name": "App Shell",
          "color": "#06b6d4",
          "items": [
            { "path": "src/ui/layout", "type": "directory" },
            { "path": "src/ui/router", "type": "directory" },
            { "path": "src/ui/inspector", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        },
        {
          "id": "ui-registries",
          "name": "View Registries",
          "color": "#f43f5e",
          "items": [
            { "path": "src/ui/registries", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        }
      ],
      "interactiveActions": [
        {
          "type": "click-file",
          "description": "See how URL paths map to domain object views",
          "target": "src/ui/router/Browse.js"
        }
      ]
    },
    {
      "id": "testing-and-examples",
      "title": "Testing & Example Plugins",
      "description": "e2e/ has Playwright tests covering visual regression and accessibility. example/ provides sample plugins — generators, imagery, fault sources — that serve as both dev tools and reference implementations for building your own plugins.",
      "focusDirectory": "",
      "colorMode": "fileTypes",
      "highlightLayers": [
        {
          "id": "testing",
          "name": "End-to-End Tests",
          "color": "#22c55e",
          "items": [
            { "path": "e2e", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        },
        {
          "id": "examples",
          "name": "Example Plugins",
          "color": "#a855f7",
          "items": [
            { "path": "example", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        }
      ],
      "interactiveActions": [
        {
          "type": "explore",
          "description": "Explore example plugins for reference implementations",
          "target": "example"
        }
      ]
    }
  ],
  "metadata": {
    "author": "FinnA13",
    "createdAt": "2026-07-01",
    "updatedAt": "2026-07-01",
    "tags": ["onboarding", "architecture", "nasa", "mission-control"]
  }
}
